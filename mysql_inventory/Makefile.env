# Image repository
IMAGE_REPO_ROOT=quay.io/larryloi

# Container CLI
CONTAINER_CLI=docker

PROJECT_NAME=sql_helper

BASE_NAME=base
BASE_VER=0.2.0

APP_NAME=faker
APP_VER=0.7.2

APP_DB=mysql_inventory
APP_TBL=orders

IMAGE_NAME=$(PROJECT_NAME)-$(APP_NAME)
IMAGE_TAG=$(APP_VER)
IMAGE_FULL_NAME=$(IMAGE_REPO_ROOT)/$(IMAGE_NAME):$(IMAGE_TAG)

db=mysql

export IMAGE_REPO_ROOT IMAGE_NAME IMAGE_TAG IMAGE_FULL_NAME
export CONTAINER_CLI PROJECT_NAME BASE_NAME BASE_VER APP_NAME APP_VER APP_DB APP_TBL db